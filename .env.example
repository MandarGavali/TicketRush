# Copy to .env and change the secrets. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://ticketrush:ticketrush@localhost:5432/ticketrush
TEST_DATABASE_URL=postgresql+psycopg://ticketrush:ticketrush@localhost:5432/ticketrush_test
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=30

HOLD_MINUTES=5
MAX_SEATS_PER_BOOKING=6
EVENT_CACHE_TTL_SECONDS=60
LOGIN_RATE_LIMIT_PER_MIN=5
BOOKING_RATE_LIMIT_PER_MIN=10
EXPIRY_SWEEP_SECONDS=30
ENABLE_SWEEPER=true
CORS_ORIGINS=["http://localhost:3000"]

SEED_ADMIN_PASSWORD=change-me-admin-password
